#!/bin/sh
set -eu
umask 077

runtime_peers=/run/bird/peers
runtime_wireguard=/run/bird/wireguard
runtime_gre=/run/bird/gre
runtime_zerotier=/run/bird/zerotier
wireguard_configs=
wireguard_peer_watcher_pid=
gre_interfaces=
zerotier_configs=
zerotier_pid=
bird_pid=
anycast_return_paths=

rm -rf "$runtime_peers" "$runtime_wireguard" "$runtime_gre" "$runtime_zerotier"
mkdir -p "$runtime_peers" "$runtime_wireguard" "$runtime_gre" "$runtime_zerotier"

render_templates() {
    source_pattern=$1
    destination=$2

    for template in $source_pattern; do
        [ -f "$template" ] || continue

        variables=$(envsubst --variables "$(cat "$template")")
        for variable in $variables; do
            if ! printenv "$variable" >/dev/null; then
                if [ "${BIRD_VALIDATE:-0}" = 1 ]; then
                    export "$variable=validation-secret"
                else
                    echo "Missing dotenvx variable: $variable" >&2
                    exit 1
                fi
            fi

            value=$(printenv "$variable")
            case "$value" in
                *'
'*)
                    echo "dotenvx variable contains a newline: $variable" >&2
                    exit 1
                    ;;
            esac
            escaped=$(printf '%s' "$value" | sed 's/\\/\\\\/g; s/"/\\"/g')
            export "$variable=$escaped"
        done

        envsubst < "$template" > "$destination/$(basename "$template")"
    done
}

validate_interface_name() {
    validated_interface=$1
    case "$validated_interface" in
        ''|*[!a-zA-Z0-9_.-]*)
            echo "Invalid tunnel interface name: $validated_interface" >&2
            exit 1
            ;;
    esac
    if [ "${#validated_interface}" -gt 15 ]; then
        echo "Tunnel interface name exceeds 15 characters: $validated_interface" >&2
        exit 1
    fi
}

configure_gre() {
    config=$1
    interface=$(basename "$config" .conf)
    validate_interface_name "$interface"

    type=
    local_address=
    remote_address=
    tunnel_addresses=
    mac_address=
    tunnel_id=
    destination_port=
    underlay_device=
    ttl=255
    mtu=

    while read -r key value extra; do
        case "$key" in
            ''|'#'*) continue ;;
        esac
        if [ -n "${extra:-}" ] || [ -z "${value:-}" ]; then
            echo "Invalid GRE setting in $config: $key" >&2
            exit 1
        fi
        case "$key" in
            type) type=$value ;;
            local) local_address=$value ;;
            remote) remote_address=$value ;;
            address) tunnel_addresses="$tunnel_addresses $value" ;;
            mac) mac_address=$value ;;
            id) tunnel_id=$value ;;
            dstport) destination_port=$value ;;
            dev) underlay_device=$value ;;
            ttl) ttl=$value ;;
            mtu) mtu=$value ;;
            *)
                echo "Unknown GRE setting in $config: $key" >&2
                exit 1
                ;;
        esac
    done < "$config"

    case "$type" in
        gre|gretap|vxlan) ttl_option=ttl ;;
        ip6gre) ttl_option=hoplimit ;;
        *)
            echo "Tunnel type must be gre, gretap, ip6gre, or vxlan in $config" >&2
            exit 1
            ;;
    esac
    if [ -z "$local_address" ] || [ -z "$remote_address" ] || [ -z "$tunnel_addresses" ]; then
        echo "GRE local, remote, and address are required in $config" >&2
        exit 1
    fi
    if [ -n "$mac_address" ] && [ "$type" != gretap ] && [ "$type" != vxlan ]; then
        echo "Tunnel MAC address is only supported for gretap or vxlan in $config" >&2
        exit 1
    fi
    if [ "$type" = vxlan ]; then
        case "$tunnel_id" in
            ''|*[!0-9]*)
                echo "VXLAN id must be a decimal integer: $config" >&2
                exit 1
                ;;
        esac
        if [ "$tunnel_id" -gt 16777215 ]; then
            echo "VXLAN id exceeds 24 bits: $config" >&2
            exit 1
        fi
        case "$destination_port" in
            ''|*[!0-9]*)
                echo "VXLAN dstport must be a decimal integer: $config" >&2
                exit 1
                ;;
        esac
        if [ "$destination_port" -lt 1 ] || [ "$destination_port" -gt 65535 ]; then
            echo "VXLAN dstport must be between 1 and 65535: $config" >&2
            exit 1
        fi
        if [ -n "$underlay_device" ]; then
            validate_interface_name "$underlay_device"
        fi
    elif [ -n "$tunnel_id" ] || [ -n "$destination_port" ] || [ -n "$underlay_device" ]; then
        echo "Tunnel id, dstport, and dev are only supported for vxlan in $config" >&2
        exit 1
    fi
    [ "${BIRD_VALIDATE:-0}" = 1 ] && return

    # A SIGKILL can leave our named tunnel behind in a host network namespace.
    if ip link show dev "$interface" >/dev/null 2>&1; then
        existing_type=$(ip -d -j link show dev "$interface")
        case "$existing_type" in
            *\"info_kind\":\"$type\"*) ;;
            *\"info_kind\":\"gre\"*|*\"info_kind\":\"gretap\"*|*\"info_kind\":\"ip6gre\"*|*\"info_kind\":\"vxlan\"*)
                echo "Replacing managed tunnel $interface with type $type" >&2
                ;;
            *)
                echo "Refusing to replace non-$type interface: $interface" >&2
                exit 1
                ;;
        esac
        ip link delete "$interface"
    fi
    if [ "$type" = vxlan ]; then
        if [ -n "$underlay_device" ]; then
            ip link add "$interface" type vxlan id "$tunnel_id" \
                local "$local_address" remote "$remote_address" \
                dstport "$destination_port" dev "$underlay_device" ttl "$ttl"
        else
            ip link add "$interface" type vxlan id "$tunnel_id" \
                local "$local_address" remote "$remote_address" \
                dstport "$destination_port" ttl "$ttl"
        fi
    else
        ip link add "$interface" type "$type" \
            local "$local_address" remote "$remote_address" "$ttl_option" "$ttl"
    fi
    gre_interfaces="$interface $gre_interfaces"
    if [ -n "$mac_address" ]; then
        ip link set dev "$interface" address "$mac_address"
    fi
    if [ -n "$mtu" ]; then
        ip link set dev "$interface" mtu "$mtu"
    fi
    for tunnel_address in $tunnel_addresses; do
        ip address add "$tunnel_address" dev "$interface"
    done
    ip link set dev "$interface" up
}

read_zerotier_config() {
    config=$1
    network=
    allow_managed=true
    allow_global=false
    allow_default=false
    allow_dns=false

    while read -r key value extra; do
        case "$key" in
            ''|'#'*) continue ;;
        esac
        if [ -n "${extra:-}" ] || [ -z "${value:-}" ]; then
            echo "Invalid ZeroTier setting in $config: $key" >&2
            exit 1
        fi
        case "$key" in
            network) network=$value ;;
            allowManaged) allow_managed=$value ;;
            allowGlobal) allow_global=$value ;;
            allowDefault) allow_default=$value ;;
            allowDNS) allow_dns=$value ;;
            *)
                echo "Unknown ZeroTier setting in $config: $key" >&2
                exit 1
                ;;
        esac
    done < "$config"

    if [ "${#network}" -ne 16 ]; then
        echo "ZeroTier network ID must contain 16 hexadecimal characters in $config" >&2
        exit 1
    fi
    case "$network" in
        *[!0-9a-f]*)
            echo "Invalid ZeroTier network ID in $config: $network" >&2
            exit 1
            ;;
    esac
    for value in "$allow_managed" "$allow_global" "$allow_default" "$allow_dns"; do
        case "$value" in
            true|false) ;;
            *)
                echo "ZeroTier options must be true or false in $config" >&2
                exit 1
                ;;
        esac
    done
}

start_zerotier() {
    [ -n "$zerotier_configs" ] || return 0

    if [ -z "${ZEROTIER_IDENTITY_SECRET:-}" ] || [ -z "${ZEROTIER_IDENTITY_PUBLIC:-}" ]; then
        echo "ZEROTIER_IDENTITY_SECRET and ZEROTIER_IDENTITY_PUBLIC are required" >&2
        exit 1
    fi

    mkdir -p /var/lib/zerotier-one/networks.d
    rm -f /var/lib/zerotier-one/networks.d/*.conf
    printf '%s\n' "$ZEROTIER_IDENTITY_SECRET" > /var/lib/zerotier-one/identity.secret
    printf '%s\n' "$ZEROTIER_IDENTITY_PUBLIC" > /var/lib/zerotier-one/identity.public
    chmod 0600 /var/lib/zerotier-one/identity.secret
    chmod 0644 /var/lib/zerotier-one/identity.public

    derived_identity=$(zerotier-idtool getpublic /var/lib/zerotier-one/identity.secret)
    if [ "$derived_identity" != "$ZEROTIER_IDENTITY_PUBLIC" ]; then
        echo "ZeroTier public and private identities do not match" >&2
        exit 1
    fi

    zerotier-one /var/lib/zerotier-one &
    zerotier_pid=$!

    attempts=0
    until zerotier-cli info >/dev/null 2>&1; do
        attempts=$((attempts + 1))
        if [ "$attempts" -ge 30 ]; then
            echo "ZeroTier daemon did not become ready" >&2
            exit 1
        fi
        sleep 1
    done

    for config in $zerotier_configs; do
        read_zerotier_config "$config"
        zerotier-cli join "$network"
        zerotier-cli set "$network" "allowManaged=$allow_managed"
        zerotier-cli set "$network" "allowGlobal=$allow_global"
        zerotier-cli set "$network" "allowDefault=$allow_default"
        zerotier-cli set "$network" "allowDNS=$allow_dns"
    done
}

configure_anycast_return_paths() {
    [ -n "${ANYCAST_RETURN_PATHS:-}" ] || return 0

    # Each path is interface,mark,table,priority[,gateway]. Dedicated policy
    # tables keep ICMP replies on the PoP through which their requests arrived.
    for path in $ANYCAST_RETURN_PATHS; do
        old_ifs=$IFS
        IFS=,
        set -- $path
        IFS=$old_ifs
        if [ "$#" -ne 4 ] && [ "$#" -ne 5 ]; then
            echo "Invalid anycast return path: $path" >&2
            exit 1
        fi
        interface=$1
        mark=$2
        table=$3
        priority=$4
        gateway=${5:--}
        validate_interface_name "$interface"
        for value in "$mark" "$table" "$priority"; do
            case "$value" in
                ''|*[!0-9]*)
                    echo "Anycast mark, table, and priority must be decimal integers: $path" >&2
                    exit 1
                    ;;
            esac
        done
        if ! ip link show dev "$interface" >/dev/null 2>&1; then
            echo "Anycast return interface does not exist: $interface" >&2
            exit 1
        fi

        if [ "$gateway" = - ]; then
            ip -6 route replace default dev "$interface" table "$table"
        else
            case "$gateway" in
                *[!0-9a-fA-F:]*)
                    echo "Invalid anycast return gateway: $gateway" >&2
                    exit 1
                    ;;
            esac
            ip -6 route replace default via "$gateway" dev "$interface" table "$table"
        fi
        ip -6 rule del pref "$priority" 2>/dev/null || true
        ip -6 rule add pref "$priority" fwmark "$mark" lookup "$table"
        nft add rule inet as218822_sav anycast_ingress \
            iifname "$interface" ct mark set "$mark"
        anycast_return_paths="$path $anycast_return_paths"
    done
}

cleanup() {
    if [ -n "$wireguard_peer_watcher_pid" ]; then
        kill -TERM "$wireguard_peer_watcher_pid" 2>/dev/null || true
        wait "$wireguard_peer_watcher_pid" 2>/dev/null || true
    fi
    for path in $anycast_return_paths; do
        old_ifs=$IFS
        IFS=,
        set -- $path
        IFS=$old_ifs
        ip -6 rule del pref "$4" 2>/dev/null || true
        ip -6 route flush table "$3" 2>/dev/null || true
    done
    for config in $wireguard_configs; do
        wg-quick down "$config" >/dev/null 2>&1 || true
    done
    for interface in $gre_interfaces; do
        ip link delete "$interface" >/dev/null 2>&1 || true
    done
    if [ -n "$zerotier_pid" ]; then
        kill -TERM "$zerotier_pid" 2>/dev/null || true
        wait "$zerotier_pid" 2>/dev/null || true
    fi
}

watch_wireguard_peers() {
    peer_config=${WIREGUARD_PEER_CONFIG:-}
    [ -n "$peer_config" ] || return 0
    interface=${WIREGUARD_PEER_INTERFACE:-portal}
    validate_interface_name "$interface"
    applied=/run/bird/${interface}-peers.applied
    base=/run/bird/${interface}-base.conf
    desired=/run/bird/${interface}-desired.conf
    # syncconf replaces interface settings as well as peers. Preserve the
    # private key and fixed listen port while replacing only dynamic peers.
    wg showconf "$interface" | sed '/^\[Peer\]/,$d' > "$base"
    chmod 0600 "$base"
    (
        while :; do
            if [ -r "$peer_config" ] && { [ ! -f "$applied" ] || ! cmp -s "$peer_config" "$applied"; }; then
                { cat "$base"; printf '\n'; cat "$peer_config"; } > "$desired"
                chmod 0600 "$desired"
                if wg syncconf "$interface" "$desired"; then
                    cp "$peer_config" "$applied"
                    chmod 0600 "$applied"
                fi
            fi
            sleep 5
        done
    ) &
    wireguard_peer_watcher_pid=$!
}

terminate() {
    if [ -n "$bird_pid" ]; then
        kill -TERM "$bird_pid" 2>/dev/null || true
    fi
}

render_templates '/etc/bird/peers/*.conf' "$runtime_peers"
render_templates '/etc/tunnels/wireguard/*.conf' "$runtime_wireguard"
render_templates '/etc/tunnels/gre/*.conf' "$runtime_gre"
render_templates '/etc/tunnels/zerotier/*.conf' "$runtime_zerotier"

for config in "$runtime_zerotier"/*.conf; do
    [ -f "$config" ] || continue
    read_zerotier_config "$config"
    zerotier_configs="$config $zerotier_configs"
done

trap cleanup EXIT
trap terminate INT TERM

# Replace only our table, atomically, before any tunnel can carry traffic.
# Keep it installed on exit so a restart never opens an unfiltered interval.
if [ "${BIRD_VALIDATE:-0}" != 1 ]; then
    nft -f /etc/bird/source-validation.nft
fi

if [ "${ENABLE_IPV6_FORWARDING:-0}" = 1 ] && [ "${BIRD_VALIDATE:-0}" != 1 ]; then
    forwarding_path=${IPV6_FORWARDING_PATH:-/proc/sys/net/ipv6/conf/all/forwarding}
    if [ ! -w "$forwarding_path" ]; then
        echo "IPv6 forwarding setting is not writable: $forwarding_path" >&2
        exit 1
    fi
    printf '1\n' > "$forwarding_path"
fi

if [ "${BIRD_VALIDATE:-0}" != 1 ]; then
    start_zerotier
fi

for config in "$runtime_wireguard"/*.conf; do
    [ -f "$config" ] || continue
    interface=$(basename "$config" .conf)
    validate_interface_name "$interface"
    wg-quick strip "$config" >/dev/null
    if [ "${BIRD_VALIDATE:-0}" != 1 ]; then
        wg-quick down "$config" >/dev/null 2>&1 || true
        wg-quick up "$config"
        wireguard_configs="$config $wireguard_configs"
    fi
done

if [ "${BIRD_VALIDATE:-0}" != 1 ]; then
    watch_wireguard_peers
fi

for config in "$runtime_gre"/*.conf; do
    [ -f "$config" ] || continue
    configure_gre "$config"
done

if [ "${BIRD_VALIDATE:-0}" != 1 ]; then
    configure_anycast_return_paths
fi

if [ "${BIRD_VALIDATE:-0}" = 1 ]; then
    exec bird -p -c /etc/bird/bird.conf
fi

bird -f -c /etc/bird/bird.conf -s /run/bird/bird.ctl &
bird_pid=$!
if wait "$bird_pid"; then
    status=0
else
    status=$?
fi
exit "$status"
