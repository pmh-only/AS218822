define local6 = { 2a06:9801:ff0::/44, fd00:218:822:100::1, fd00:218:822:2014:23:: }
define upstreams = { "4ixp", "evix-nz", "hkix-gretap", "lagrange", "p7ix-342", "tun10012", "zxix" }

add table inet as218822_sav
delete table inet as218822_sav
table inet as218822_sav {
    set transport6 {
        type ipv6_addr
        elements = { 2001:7f8:d0::3:56c6:1, 2602:fed2:fff:ffff:6::11d,
            2602:f92a:1315:2::b5,
            2602:f92a:1315:3::28, 2406:840:1f:1000::21:8822:1,
            fd:e82c::2, 2a01:20e:1000:117::2 }
    }
    set transport4 {
        type ipv4_addr
        elements = { 10.156.73.181, 10.156.74.40, 10.255.101.192, 10.144.55.2 }
    }

    include "/etc/bird-source-validation.nft"

    counter ingress_spoof { }
    counter portal_denied { }
    chain stub_source {
        type filter hook prerouting priority -300; policy accept;
        iifname "gh*" jump github_peers
        iifname $upstreams ip6 saddr { 2a06:9801:ff0::/48, fd7a:115c:a1e0::/48 } counter name ingress_spoof drop
        iifname "lunalight" ip6 saddr fd00:218:822:2014:23::1 ip6 daddr fd00:218:822:2014:23:: return
        iifname "lunalight" ip6 saddr { 2a0f:6284:b::/48, 2a0f:6284:c::/48 } return
        iifname "lunalight" counter name ingress_spoof drop
        # WireGuard cryptokey routing also enforces each client's assigned /128.
        iifname "portal" ip6 saddr != 2a06:9801:ff0:200::/64 counter name ingress_spoof drop
    }

    chain portal_input {
        type filter hook input priority 0; policy accept;
        # Tunnel users receive internet transit, not access to the router itself.
        iifname "portal" counter name portal_denied drop
    }

    chain portal_forward {
        type filter hook forward priority 0; policy accept;
        # Keep users isolated from one another and AS218822 infrastructure.
        iifname "portal" ip6 daddr 2a06:9801:ff0::/44 counter name portal_denied drop
        iifname "portal" ip6 daddr != 2000::/3 counter name portal_denied drop
    }

    chain github_peers {
        # PEERING_AUTOMATION_INSERT
    }
    chain egress {
        type filter hook postrouting priority 110; policy accept;
        oifname $upstreams jump upstream_source
    }
}
