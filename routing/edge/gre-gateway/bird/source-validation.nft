define local6 = { 2a06:9801:ff0::/44, fd00:218:822:100::1, fd00:218:822:2014:23:: }
define upstreams = { "hkix-gretap", "lagrange", "tun10006" }

add table inet as218822_sav
delete table inet as218822_sav
table inet as218822_sav {
    set transport6 {
        type ipv6_addr
        elements = { 2602:f92a:1315:2::b5, fd:e82c::2, 2a01:20e:1000:111::2 }
    }
    set transport4 {
        type ipv4_addr
        elements = { 10.156.73.181, 10.144.55.2 }
    }

    include "/etc/bird-source-validation.nft"

    counter ingress_spoof { }
    chain stub_source {
        type filter hook prerouting priority -300; policy accept;
        iifname $upstreams ip6 saddr { 2a06:9801:ff0::/48, fd7a:115c:a1e0::/48 } counter name ingress_spoof drop
        iifname "lunalight" ip6 saddr fd00:218:822:2014:23::1 ip6 daddr fd00:218:822:2014:23:: return
        iifname "lunalight" ip6 saddr { 2a0f:6284:b::/48, 2a0f:6284:c::/48 } return
        iifname "lunalight" counter name ingress_spoof drop
    }
    chain egress {
        type filter hook postrouting priority 110; policy accept;
        oifname $upstreams jump upstream_source
    }
}
