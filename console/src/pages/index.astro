---
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Live AS218822 network monitoring console" />
    <meta name="theme-color" content="#080a0d" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 fill=%22%237149dd%22/><text x=%2250%22 y=%2267%22 text-anchor=%22middle%22 font-size=%2245%22 font-family=%22monospace%22 fill=%22white%22>AS</text></svg>" />
    <title>AS218822 / Live Console</title>
    <style is:global>
      * { box-sizing: border-box; }
      html { background: #080a0d; }
      body { min-width: 20rem; min-height: 100vh; margin: 0; background: radial-gradient(circle at 77% 0%, rgb(109 72 210 / 13%), transparent 32rem), #080a0d; color: #dce3e9; font-family: "IBM Plex Mono", monospace; }
      button { font: inherit; }
      ::selection { background: #7150d2; color: white; }
      .shell { display: grid; grid-template-columns: 14rem minmax(0, 1fr); min-height: 100vh; }
      aside { position: sticky; top: 0; display: flex; flex-direction: column; height: 100vh; padding: 1.4rem; border-right: 1px solid #252b31; background: rgb(7 9 12 / 90%); backdrop-filter: blur(16px); }
      .brand { display: flex; align-items: center; gap: 0.75rem; color: #f1f3f5; font-size: 0.75rem; font-weight: 600; }
      .brand-mark { display: grid; width: 2rem; height: 2rem; place-items: center; background: #7149dd; color: white; font-size: 0.6rem; }
      .brand small { display: block; margin-top: 0.14rem; color: #69727b; font-size: 0.5rem; font-weight: 400; letter-spacing: 0.1em; text-transform: uppercase; }
      nav { display: grid; gap: 0.3rem; margin-top: 3.5rem; }
      nav a { padding: 0.7rem; border-left: 1px solid transparent; color: #69727b; font-size: 0.6rem; text-decoration: none; text-transform: uppercase; }
      nav a:first-child { border-color: #8d70db; background: linear-gradient(90deg, rgb(113 73 221 / 15%), transparent); color: #e0d8f6; }
      .connection { margin-top: auto; color: #5d6670; font-size: 0.52rem; line-height: 1.7; text-transform: uppercase; }
      .connection strong { display: flex; align-items: center; gap: 0.45rem; color: #cbd2d8; font-weight: 500; }
      .connection i, .live-dot { width: 0.4rem; height: 0.4rem; border-radius: 50%; background: #767e86; }
      .connection i.online, .live-dot.online { background: #48c58a; box-shadow: 0 0 0.6rem #48c58a; }
      main { min-width: 0; padding: clamp(1.3rem, 3.5vw, 3.5rem); }
      header { display: flex; justify-content: space-between; gap: 2rem; align-items: end; padding-bottom: 1.8rem; border-bottom: 1px solid #252b31; }
      .kicker { margin: 0 0 0.7rem; color: #8b69e4; font-size: 0.56rem; letter-spacing: 0.14em; text-transform: uppercase; }
      h1 { margin: 0; color: #f0f2f4; font-size: clamp(2rem, 4.5vw, 4.2rem); font-weight: 500; letter-spacing: -0.075em; line-height: 0.9; }
      .refresh { display: flex; align-items: center; gap: 0.7rem; padding: 0.65rem 0.8rem; border: 1px solid #30373e; background: #101419; color: #9da6ad; cursor: pointer; font-size: 0.55rem; text-transform: uppercase; }
      .refresh:hover { border-color: #66519f; color: white; }
      .refresh:disabled { cursor: wait; opacity: 0.55; }
      .summary { display: grid; grid-template-columns: repeat(5, 1fr); border-bottom: 1px solid #252b31; }
      .metric { min-width: 0; padding: 1.35rem 1rem 1.35rem 0; }
      .metric + .metric { padding-left: 1.2rem; border-left: 1px solid #252b31; }
      .metric span { color: #626c75; font-size: 0.5rem; letter-spacing: 0.08em; text-transform: uppercase; }
      .metric strong { display: block; margin-top: 0.65rem; color: #e9edef; font-size: clamp(1.15rem, 2.2vw, 1.75rem); font-weight: 400; letter-spacing: -0.06em; }
      .metric strong.warn { color: #e3a84f; }
      .dashboard { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(19rem, 0.6fr); gap: 0.9rem; padding-top: 0.9rem; }
      .panel { min-width: 0; border: 1px solid #252b31; background: rgb(13 16 20 / 78%); }
      .panel-head { display: flex; justify-content: space-between; align-items: center; min-height: 2.9rem; padding: 0 0.9rem; border-bottom: 1px solid #252b31; }
      .panel-head h2 { margin: 0; color: #b9c0c6; font-size: 0.58rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; }
      .panel-head span { color: #59626a; font-size: 0.48rem; text-transform: uppercase; }
      .chart-panel { grid-column: 1 / -1; }
      .chart-wrap { position: relative; height: 12rem; padding: 1rem; }
      #history-chart { width: 100%; height: 100%; overflow: visible; }
      .chart-grid { stroke: #272e35; stroke-width: 1; }
      .chart-area { fill: url(#area); }
      .chart-line { fill: none; stroke: #8866df; stroke-width: 2; vector-effect: non-scaling-stroke; }
      .chart-empty { display: grid; height: 100%; place-items: center; color: #626c75; font-size: 0.58rem; }
      .protocols { display: grid; grid-template-columns: repeat(2, 1fr); }
      .protocol { display: grid; grid-template-columns: 0.65rem 1fr auto; gap: 0.65rem; align-items: center; min-width: 0; padding: 0.85rem 0.9rem; border-bottom: 1px solid #22282e; }
      .protocol:nth-child(odd) { border-right: 1px solid #22282e; }
      .protocol i, .state-dot { width: 0.38rem; height: 0.38rem; border-radius: 50%; background: #d75561; box-shadow: 0 0 0.55rem #d75561; }
      .protocol.up i, .state-dot.up { background: #41b980; box-shadow: 0 0 0.55rem #41b980; }
      .protocol strong { display: block; overflow: hidden; color: #d8dde1; font-size: 0.58rem; font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
      .protocol small { display: block; margin-top: 0.2rem; color: #58636c; font-size: 0.48rem; text-transform: uppercase; }
      .protocol em { color: #626d76; font-size: 0.46rem; font-style: normal; text-transform: uppercase; }
      .stack { display: grid; gap: 0.9rem; align-content: start; }
      .states { display: grid; }
      .state { display: grid; grid-template-columns: 0.65rem minmax(0, 1fr) auto; gap: 0.65rem; align-items: center; padding: 0.8rem 0.9rem; border-bottom: 1px solid #22282e; }
      .state:last-child { border-bottom: 0; }
      .state strong { display: block; overflow: hidden; color: #d4dade; font-size: 0.56rem; font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
      .state small { display: block; overflow: hidden; margin-top: 0.2rem; color: #59636c; font-size: 0.46rem; text-overflow: ellipsis; white-space: nowrap; }
      .state b { color: #657078; font-size: 0.45rem; font-weight: 400; text-transform: uppercase; }
      .alerts-empty { padding: 1.3rem 0.9rem; color: #66717a; font-size: 0.54rem; }
      .alert { padding: 0.85rem 0.9rem; border-left: 2px solid #d69a42; border-bottom: 1px solid #22282e; background: rgb(214 154 66 / 5%); }
      .alert:last-child { border-bottom: 0; }
      .alert strong { display: block; color: #e5bf84; font-size: 0.56rem; font-weight: 500; }
      .alert small { display: block; margin-top: 0.3rem; color: #736958; font-size: 0.47rem; }
      .error-banner { display: none; margin-top: 0.9rem; padding: 0.9rem; border: 1px solid #79353b; background: #211114; color: #e68b93; font-size: 0.58rem; }
      .error-banner.visible { display: block; }
      .skeleton { position: relative; overflow: hidden; color: transparent !important; background: #151a20; }
      .skeleton::after { position: absolute; inset: 0; background: linear-gradient(90deg, transparent, rgb(255 255 255 / 4%), transparent); content: ""; animation: scan 1.4s infinite; }
      @keyframes scan { from { transform: translateX(-100%); } to { transform: translateX(100%); } }
      @media (max-width: 68rem) { .summary { grid-template-columns: repeat(3, 1fr); } .metric:nth-child(4) { border-left: 0; border-top: 1px solid #252b31; } .metric:nth-child(n + 4) { border-top: 1px solid #252b31; } .dashboard { grid-template-columns: 1fr; } .chart-panel { grid-column: auto; } }
      @media (max-width: 50rem) { .shell { grid-template-columns: 1fr; } aside { position: static; display: flex; flex-direction: row; justify-content: space-between; height: auto; border-right: 0; border-bottom: 1px solid #252b31; } nav { display: none; } .connection { margin: 0; text-align: right; } }
      @media (max-width: 35rem) { main { padding: 1rem; } header { align-items: end; } .refresh span { display: none; } .summary { grid-template-columns: repeat(2, 1fr); } .metric:nth-child(3) { border-left: 0; } .metric:nth-child(n + 3) { border-top: 1px solid #252b31; } .protocols { grid-template-columns: 1fr; } .protocol:nth-child(odd) { border-right: 0; } }
      @media (prefers-reduced-motion: reduce) { .skeleton::after { animation: none; } }
    </style>
  </head>
  <body>
    <div class="shell">
      <aside>
        <div class="brand"><span class="brand-mark">AS</span><span>218822<small>live operations</small></span></div>
        <nav aria-label="Console navigation"><a href="#overview">Overview</a><a href="#sessions">BGP sessions</a><a href="#infrastructure">Infrastructure</a><a href="#alerts">Alerts</a></nav>
        <div class="connection"><strong><i id="connection-dot"></i><span id="connection-state">Connecting</span></strong><span id="updated-at">Awaiting telemetry</span></div>
      </aside>

      <main id="overview">
        <header>
          <div><p class="kicker">Live telemetry / Prometheus</p><h1>Network<br />operations</h1></div>
          <button class="refresh" id="refresh" type="button" aria-label="Refresh monitoring data"><span>Refresh data</span> <b aria-hidden="true">&#8635;</b></button>
        </header>
        <div class="error-banner" id="error" role="alert"></div>

        <section class="summary" aria-label="Live network summary">
          <div class="metric"><span>BGP sessions</span><strong id="bgp-summary" class="skeleton">-- / --</strong></div>
          <div class="metric"><span>Routers online</span><strong id="router-summary" class="skeleton">-- / --</strong></div>
          <div class="metric"><span>Containers ready</span><strong id="container-summary" class="skeleton">-- / --</strong></div>
          <div class="metric"><span>Active alerts</span><strong id="alert-summary" class="skeleton">--</strong></div>
          <div class="metric"><span>Validated VRPs</span><strong id="vrp-summary" class="skeleton">--</strong></div>
        </section>

        <div class="dashboard">
          <section class="panel chart-panel">
            <div class="panel-head"><h2>BGP availability</h2><span>Last 6 hours / 5 minute resolution</span></div>
            <div class="chart-wrap" id="chart-wrap"><div class="chart-empty">Loading history...</div></div>
          </section>

          <section class="panel" id="sessions">
            <div class="panel-head"><h2>BGP sessions</h2><span id="session-count">Live state</span></div>
            <div class="protocols" id="protocols"><div class="alerts-empty">Loading sessions...</div></div>
          </section>

          <div class="stack" id="infrastructure">
            <section class="panel">
              <div class="panel-head"><h2>IPv6 probes</h2><span>External reachability</span></div>
              <div class="states" id="probes"><div class="alerts-empty">Loading probes...</div></div>
            </section>
            <section class="panel">
              <div class="panel-head"><h2>Workloads</h2><span id="workload-count">Kubernetes</span></div>
              <div class="states" id="workloads"><div class="alerts-empty">Loading workloads...</div></div>
            </section>
            <section class="panel" id="alerts">
              <div class="panel-head"><h2>Active alerts</h2><span>Prometheus rules</span></div>
              <div id="alerts-list"><div class="alerts-empty">Loading alerts...</div></div>
            </section>
          </div>
        </div>
      </main>
    </div>

    <script>
      // @ts-nocheck
      const elements = Object.fromEntries(["bgp-summary", "router-summary", "container-summary", "alert-summary", "vrp-summary", "connection-dot", "connection-state", "updated-at", "refresh", "error", "chart-wrap", "protocols", "session-count", "probes", "workloads", "workload-count", "alerts-list"].map((id) => [id, document.getElementById(id)]));
      const escapeHtml = (value) => String(value ?? "").replace(/[&<>'"]/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;" })[character]);
      const label = (value) => String(value ?? "unknown").replace(/_/g, " ");

      function setMetric(id, value, warning = false) {
        const element = elements[id];
        element.textContent = value;
        element.classList.remove("skeleton");
        element.classList.toggle("warn", warning);
      }

      function drawHistory(history) {
        if (!history.length) {
          elements["chart-wrap"].innerHTML = '<div class="chart-empty">No historical samples available.</div>';
          return;
        }
        const width = 1000;
        const height = 150;
        const maximum = Math.max(...history.map((point) => point.total), 1);
        const points = history.map((point, index) => {
          const x = history.length === 1 ? 0 : (index / (history.length - 1)) * width;
          const y = height - (point.up / maximum) * (height - 12) - 6;
          return `${x.toFixed(1)},${y.toFixed(1)}`;
        }).join(" ");
        const area = `0,${height} ${points} ${width},${height}`;
        elements["chart-wrap"].innerHTML = `<svg id="history-chart" viewBox="0 0 ${width} ${height}" preserveAspectRatio="none" role="img" aria-label="BGP sessions up over the last six hours"><defs><linearGradient id="area" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7956d3" stop-opacity=".35"/><stop offset="1" stop-color="#7956d3" stop-opacity="0"/></linearGradient></defs><line class="chart-grid" x1="0" y1="${height / 2}" x2="${width}" y2="${height / 2}"/><polygon class="chart-area" points="${area}"/><polyline class="chart-line" points="${points}"/></svg>`;
      }

      function render(data) {
        const summary = data.summary;
        setMetric("bgp-summary", `${summary.bgpUp} / ${summary.bgpTotal}`, summary.bgpUp < summary.bgpTotal);
        setMetric("router-summary", `${summary.routersUp} / ${summary.routersTotal}`, summary.routersUp < summary.routersTotal);
        setMetric("container-summary", `${summary.containersReady} / ${summary.containersTotal}`, summary.containersReady < summary.containersTotal);
        setMetric("alert-summary", String(summary.activeAlerts), summary.activeAlerts > 0);
        setMetric("vrp-summary", summary.vrps === null ? "N/A" : new Intl.NumberFormat("en").format(summary.vrps));
        elements["connection-dot"].classList.add("online");
        elements["connection-state"].textContent = "Telemetry online";
        elements["updated-at"].textContent = `Updated ${new Date(data.generatedAt).toLocaleTimeString([], { hour12: false })}`;
        elements.error.classList.remove("visible");

        const bgp = data.protocols.filter((protocol) => protocol.type === "BGP");
        elements["session-count"].textContent = `${summary.bgpUp} of ${summary.bgpTotal} established`;
        elements.protocols.innerHTML = bgp.map((protocol) => `<div class="protocol ${protocol.up ? "up" : ""}"><i></i><span><strong>${escapeHtml(label(protocol.name))}</strong><small>${escapeHtml(protocol.location)}</small></span><em>${protocol.up ? "Established" : "Down"}</em></div>`).join("");
        elements.probes.innerHTML = data.reachability.map((probe) => `<div class="state"><i class="state-dot ${probe.reachable ? "up" : ""}"></i><span><strong>${escapeHtml(probe.target)}</strong><small>${escapeHtml(probe.location)}</small></span><b>${probe.reachable ? "Reachable" : "Failed"}</b></div>`).join("") || '<div class="alerts-empty">No probes configured.</div>';
        elements["workload-count"].textContent = `${summary.containersReady} of ${summary.containersTotal} ready`;
        elements.workloads.innerHTML = data.containers.map((container) => `<div class="state"><i class="state-dot ${container.ready ? "up" : ""}"></i><span><strong>${escapeHtml(label(container.name))}</strong><small>${escapeHtml(container.pod)}</small></span><b>${container.ready ? "Ready" : "Not ready"}</b></div>`).join("");
        elements["alerts-list"].innerHTML = data.alerts.length ? data.alerts.map((alert) => `<div class="alert"><strong>${escapeHtml(label(alert.name))}</strong><small>${escapeHtml([alert.severity, alert.location, label(alert.protocol)].filter(Boolean).join(" / "))}</small></div>`).join("") : '<div class="alerts-empty">No active AS218822 alerts.</div>';
        drawHistory(data.history);
      }

      async function refresh() {
        elements.refresh.disabled = true;
        try {
          const response = await fetch("/api/status", { cache: "no-store" });
          const data = await response.json();
          if (!response.ok) throw new Error(data.error || `Monitoring request failed (${response.status})`);
          render(data);
        } catch (error) {
          elements["connection-dot"].classList.remove("online");
          elements["connection-state"].textContent = "Telemetry unavailable";
          elements.error.textContent = error instanceof Error ? error.message : "Monitoring data is unavailable.";
          elements.error.classList.add("visible");
        } finally {
          elements.refresh.disabled = false;
        }
      }

      elements.refresh.addEventListener("click", refresh);
      refresh();
      setInterval(refresh, 30_000);
    </script>
  </body>
</html>
