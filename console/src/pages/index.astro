---
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";

const services = [
  { name: "Core router", detail: "BIRD / Asia Pacific", tone: "#7650de" },
  { name: "GRE gateway", detail: "Edge transport", tone: "#38a7b8" },
  { name: "RPKI validator", detail: "Route origin validation", tone: "#c89037" },
  { name: "RIPE Atlas", detail: "Measurement probe", tone: "#47a879" },
];

const links = [
  { label: "Repository", detail: "Routing policy and resources", href: "https://github.com/pmh-only/AS218822" },
  { label: "Builds", detail: "Container workflows", href: "https://github.com/pmh-only/AS218822/actions/workflows/build-container.yml" },
  { label: "RIPE resources", detail: "Registry source of truth", href: "https://github.com/pmh-only/AS218822/tree/main/ripe" },
  { label: "PeeringDB", detail: "Network record 43433", href: "https://www.peeringdb.com/net/43433" },
  { label: "Looking glass", detail: "Public route diagnostics", href: "https://as218822.net/#looking-glass" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="AS218822 network management console" />
    <meta name="theme-color" content="#0a0d10" />
    <title>AS218822 / Console</title>
    <style>
      :global(*) { box-sizing: border-box; }
      :global(html) { background: #080a0d; }
      :global(body) {
        min-width: 20rem;
        min-height: 100vh;
        margin: 0;
        background:
          radial-gradient(circle at 78% 0%, rgb(122 61 255 / 12%), transparent 29rem),
          #080a0d;
        color: #dce3e9;
        font-family: "IBM Plex Mono", monospace;
      }
      :global(a) { color: inherit; }
      :global(::selection) { background: #6f45db; color: #fff; }

      .shell { display: grid; grid-template-columns: 15rem minmax(0, 1fr); min-height: 100vh; }
      aside {
        position: sticky;
        top: 0;
        display: flex;
        flex-direction: column;
        height: 100vh;
        padding: 1.5rem;
        border-right: 1px solid #242a30;
        background: rgb(8 10 13 / 88%);
        backdrop-filter: blur(18px);
      }
      .brand { display: flex; align-items: center; gap: 0.75rem; font-size: 0.8rem; font-weight: 650; letter-spacing: -0.03em; }
      .brand-mark { display: grid; width: 2rem; height: 2rem; place-items: center; background: #7047dd; color: white; font-size: 0.62rem; }
      .brand small { display: block; margin-top: 0.15rem; color: #6f7881; font-size: 0.56rem; font-weight: 450; letter-spacing: 0.11em; text-transform: uppercase; }
      nav { display: grid; gap: 0.35rem; margin-top: 4rem; }
      nav a { padding: 0.75rem; border-left: 1px solid transparent; color: #727b84; font-size: 0.68rem; text-decoration: none; text-transform: uppercase; }
      nav a:first-child { border-color: #8f6bea; background: linear-gradient(90deg, rgb(112 71 221 / 15%), transparent); color: #e4ddfa; }
      .scope { margin-top: auto; color: #58616a; font-size: 0.58rem; line-height: 1.7; text-transform: uppercase; }
      .scope strong { display: block; color: #a7b0b8; font-weight: 500; }

      main { min-width: 0; padding: clamp(1.5rem, 4vw, 4rem); }
      header { display: flex; justify-content: space-between; gap: 2rem; align-items: start; padding-bottom: 2rem; border-bottom: 1px solid #242a30; }
      .kicker { margin: 0 0 0.8rem; color: #8465d3; font-size: 0.6rem; letter-spacing: 0.15em; text-transform: uppercase; }
      h1 { margin: 0; color: #f2f4f6; font-size: clamp(2rem, 5vw, 4.5rem); font-weight: 520; letter-spacing: -0.075em; line-height: 0.95; }
      .clock { padding-top: 0.35rem; color: #68717a; font-size: 0.62rem; text-align: right; text-transform: uppercase; }
      .clock output { display: block; margin-top: 0.35rem; color: #c9d1d8; font-size: 0.78rem; }

      .summary { display: grid; grid-template-columns: repeat(4, 1fr); border-bottom: 1px solid #242a30; }
      .metric { padding: 1.6rem 1rem 1.6rem 0; }
      .metric + .metric { padding-left: 1.4rem; border-left: 1px solid #242a30; }
      .metric span { color: #69727a; font-size: 0.57rem; letter-spacing: 0.09em; text-transform: uppercase; }
      .metric strong { display: block; margin-top: 0.75rem; color: #edf0f2; font-size: clamp(1.35rem, 2.6vw, 2rem); font-weight: 450; letter-spacing: -0.06em; }

      .grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr); gap: 1rem; padding-top: 1rem; }
      .panel { border: 1px solid #242a30; background: rgb(13 16 20 / 75%); }
      .panel-head { display: flex; justify-content: space-between; align-items: center; min-height: 3.1rem; padding: 0 1rem; border-bottom: 1px solid #242a30; }
      .panel-head h2 { margin: 0; color: #afb7be; font-size: 0.63rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; }
      .panel-head span { color: #505961; font-size: 0.54rem; text-transform: uppercase; }

      .topology { position: relative; min-height: 24rem; overflow: hidden; background-image: radial-gradient(#343b42 0.7px, transparent 0.7px); background-size: 18px 18px; }
      .topology::before, .topology::after { position: absolute; height: 1px; background: linear-gradient(90deg, #7047dd, #2c7480); content: ""; transform-origin: left; }
      .topology::before { top: 48%; left: 28%; width: 47%; transform: rotate(-21deg); }
      .topology::after { top: 48%; left: 28%; width: 46%; transform: rotate(25deg); }
      .node { position: absolute; z-index: 1; width: 8.5rem; padding: 0.8rem; border: 1px solid #333b43; background: #101419; box-shadow: 0 0 0 4px rgb(8 10 13 / 80%); }
      .node strong { display: block; color: #e6eaed; font-size: 0.68rem; font-weight: 500; }
      .node small { display: block; margin-top: 0.35rem; color: #657079; font-size: 0.54rem; }
      .node i { display: inline-block; width: 0.38rem; height: 0.38rem; margin-right: 0.4rem; border-radius: 50%; background: #7650de; box-shadow: 0 0 0.6rem #7650de; }
      .node.core { top: 42%; left: calc(28% - 4.25rem); border-color: #684bb8; }
      .node.upstreams { top: 13%; left: 69%; }
      .node.edge { right: 8%; bottom: 15%; }
      .node.registry { left: 7%; bottom: 10%; }

      .services { display: grid; }
      .service { display: grid; grid-template-columns: 0.7rem 1fr auto; gap: 0.8rem; align-items: center; padding: 1.05rem 1rem; border-bottom: 1px solid #242a30; }
      .service:last-child { border-bottom: 0; }
      .service i { width: 0.42rem; height: 0.42rem; border-radius: 50%; background: var(--tone); box-shadow: 0 0 0.65rem var(--tone); }
      .service strong { display: block; color: #d6dce1; font-size: 0.65rem; font-weight: 500; }
      .service small { display: block; margin-top: 0.28rem; color: #626b74; font-size: 0.54rem; }
      .service em { color: #59636c; font-size: 0.5rem; font-style: normal; text-transform: uppercase; }
      .links { grid-column: 1 / -1; }
      .link-list { display: grid; grid-template-columns: repeat(5, 1fr); }
      .link-list a { min-height: 7rem; padding: 1.1rem; border-right: 1px solid #242a30; text-decoration: none; transition: background 150ms ease; }
      .link-list a:last-child { border-right: 0; }
      .link-list a:hover { background: #151a20; }
      .link-list strong { display: block; color: #ced5db; font-size: 0.63rem; font-weight: 500; }
      .link-list small { display: block; margin-top: 0.55rem; color: #606a73; font-size: 0.52rem; line-height: 1.5; }
      .link-list b { display: block; margin-top: 1rem; color: #7959ce; font-size: 0.7rem; font-weight: 400; }

      @media (max-width: 62rem) {
        .shell { grid-template-columns: 1fr; }
        aside { position: static; display: grid; grid-template-columns: 1fr auto; height: auto; border-right: 0; border-bottom: 1px solid #242a30; }
        nav { display: none; }
        .scope { margin: 0; text-align: right; }
        .grid { grid-template-columns: 1fr; }
        .links { grid-column: auto; }
        .link-list { grid-template-columns: repeat(2, 1fr); }
        .link-list a { border-bottom: 1px solid #242a30; }
      }
      @media (max-width: 38rem) {
        main { padding: 1.25rem; }
        header { align-items: end; }
        .summary { grid-template-columns: repeat(2, 1fr); }
        .metric:nth-child(3) { border-left: 0; }
        .metric:nth-child(n + 3) { border-top: 1px solid #242a30; }
        .topology { min-height: 20rem; }
        .node { width: 7rem; }
        .node.core { left: calc(24% - 3.5rem); }
        .node.upstreams { left: auto; right: 5%; }
        .node.registry { left: 3%; }
        .node.edge { right: 4%; }
        .topology::before, .topology::after { left: 24%; }
        .link-list { grid-template-columns: 1fr; }
        .link-list a { min-height: auto; border-right: 0; }
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <aside>
        <div class="brand"><span class="brand-mark">AS</span><span>218822<small>operator console</small></span></div>
        <nav aria-label="Console navigation"><a href="#overview">Overview</a><a href="#topology">Topology</a><a href="#services">Services</a><a href="#resources">Resources</a></nav>
        <p class="scope">Access mode<strong>Read only</strong></p>
      </aside>

      <main id="overview">
        <header>
          <div><p class="kicker">Network control plane / APAC</p><h1>Operations<br />overview</h1></div>
          <div class="clock">UTC system time<output id="clock">--:--:--</output></div>
        </header>

        <section class="summary" aria-label="Network summary">
          <div class="metric"><span>Autonomous system</span><strong>218822</strong></div>
          <div class="metric"><span>Address family</span><strong>IPv6</strong></div>
          <div class="metric"><span>Announced space</span><strong>/44</strong></div>
          <div class="metric"><span>Registry</span><strong>RIPE</strong></div>
        </section>

        <div class="grid">
          <section class="panel" id="topology">
            <div class="panel-head"><h2>Network topology</h2><span>Configured view</span></div>
            <div class="topology">
              <div class="node core"><strong><i></i>Core</strong><small>Primary BIRD router</small></div>
              <div class="node upstreams"><strong><i></i>Transit mesh</strong><small>Global IPv6 upstreams</small></div>
              <div class="node edge"><strong><i></i>GRE edge</strong><small>Regional transport</small></div>
              <div class="node registry"><strong><i></i>RPKI</strong><small>Origin validation</small></div>
            </div>
          </section>

          <section class="panel" id="services">
            <div class="panel-head"><h2>Service inventory</h2><span>4 components</span></div>
            <div class="services">
              {services.map((service) => (
                <div class="service" style={`--tone: ${service.tone}`}>
                  <i></i><span><strong>{service.name}</strong><small>{service.detail}</small></span><em>managed</em>
                </div>
              ))}
            </div>
          </section>

          <section class="panel links" id="resources">
            <div class="panel-head"><h2>Operator resources</h2><span>External systems</span></div>
            <div class="link-list">
              {links.map((link) => <a href={link.href}><strong>{link.label}</strong><small>{link.detail}</small><b aria-hidden="true">-&gt;</b></a>)}
            </div>
          </section>
        </div>
      </main>
    </div>
    <script>
      const clock = document.querySelector("#clock");
      const updateClock = () => {
        if (clock) clock.textContent = new Date().toISOString().slice(11, 19);
      };
      updateClock();
      setInterval(updateClock, 1_000);
    </script>
  </body>
</html>
