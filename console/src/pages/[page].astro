---
import Dashboard from "../components/Dashboard.jsx";
import "@carbon/styles/css/styles.css";
import "@carbon/charts-react/styles.css";

export function getStaticPaths() {
  return ["tunnels", "routing", "traffic", "validation", "workloads", "operator", "sources"].map((page) => ({
    params: { page },
    props: { page },
  }));
}

const { page } = Astro.props;
---

<!doctype html>
<html lang="en" style="color-scheme: dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content="Live AS218822 network monitoring console" />
    <meta name="theme-color" content="#161616" />
    <link rel="icon" href="data:," />
    <title>AS218822 / Live Console</title>
  </head>
  <body class="cds--g100">
    <Dashboard page={page} client:only="react" />
  </body>
</html>
